{
  "name": "ondolog",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  "routes": [{ "pattern": "ondolog.paritto.dev", "custom_domain": true }],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ondolog",
      "database_id": "6ffe6469-31a0-4a22-95b4-cef3c800fbf9",
      "migrations_dir": "./drizzle"
    }
  ],
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": {
    "MISSING_DATA_THRESHOLD_MINUTES": "30",
    "ALERT_COOLDOWN_MINUTES": "60",
    "ALERT_EMAIL_TO": "okumuradaichi2007@gmail.com",
    "ALERT_EMAIL_FROM": "alerts@ondolog.paritto.dev"
  }
  // RESEND_API_KEYは機密情報のため`wrangler secret put RESEND_API_KEY`で設定する（vars直書き禁止）
}
